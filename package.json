{
  "name": "codex-open-sea",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "Open Sea for Codex · 动态海洋与本地壁纸控制端 / Local ocean and wallpaper companion",
  "main": "src/main.cjs",
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:mac-media": "node scripts/build-mac-media.mjs",
    "start": "npm run build && npm run build:mac-media && electron .",
    "test": "node --test tests/*.test.mjs",
    "package": "npm run build && node scripts/build-mac-media.mjs && electron-builder",
    "test:browser": "node --test tests/*.browser.mjs",
    "test:electron": "npm run build && node --test --test-concurrency=1 tests/*.electron.mjs"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@playwright/test": "1.64.1",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "io.github.ddev0101.codexopensea",
    "productName": "Open Sea for Codex",
    "files": [
      "src/**",
      "ui/**",
      "dist/**",
      "licenses/**",
      "LICENSE",
      "package.json",
      "NOTICE",
      "THIRD_PARTY_NOTICES.md",
      "docs/COMMERCIAL-LICENSE.md"
    ],
    "asarUnpack": [
      "src/platform-windows.ps1",
      "dist/native/**"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "identity": "-",
      "notarize": false,
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "image-size": "2.0.4"
  },
  "author": "d-dev0101",
  "homepage": "https://github.com/d-dev0101/open-sea-for-codex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d-dev0101/open-sea-for-codex.git"
  }
}
